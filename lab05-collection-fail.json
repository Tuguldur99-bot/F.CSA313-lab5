              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\": \"S_T01\", \"courseID\": \"C_T01\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Амжилттай бүртгэл: статус 200\" , function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Амжилттай бүртгэл: result = OK\", function () {",
                  "    pm.expect(pm.response.json().result).to.eql(\"OK\");",
                  "});",
                  "pm.test(\"registrationID нь тоо байна\", function () {",
                  "    pm.expect(pm.response.json().registrationID).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
