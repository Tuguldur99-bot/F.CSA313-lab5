  "item": [
    {
      "name": "T01 Урьдач хангасан идэвхтэй оюутан амжилттай бүртгүүлнэ",
      "item": [
        {
          "name": "Setup: оюутан",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/students/S_T01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "S_T01"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"active\", \"coursesTaken\": [\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup амжилттай: оюутан (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().result).to.eql(\"OK\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup: хичээл",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/C_T01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "C_T01"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\": [\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup амжилттай: хичээл (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().result).to.eql(\"OK\");",
